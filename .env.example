# OpenRouter API Keys (Multiple keys can be comma-separated for automatic rotation)
OPENROUTER_API_KEYS=sk-or-v1-your-openrouter-key-here

# Selectable Chat Models: model_id|Display Name (comma-separated)
# Models with :free prefix and openrouter/free are 100% free!
CHAT_MODELS="inclusionai/ling-3.0-flash-fin:free|Ling 3.0 Flash,cohere/north-mini-code:free|North Mini Code,dots-studio/dots-3-note-preview:free|Dots3 Note,inclusionai/ling-3.0-flash-vl:free|Ling 3.0 VL,nvidia/nemotron-3-super-120b-a12b:free|Nemotron Super 120B,nvidia/nemotron-3.5-lightning:free|Nemotron Lightning,openrouter/free|Free Router,liquid/lfm-2.5-2.6b:free|LFM 2.5,z-ai/glm-5.3-flash|GLM-5.3 Flash,hf:Qwen/Qwen3-4B-Instruct-2507|Qwen3 4B,hf:openai/gpt-oss-20b|GPT-OSS 20B,hf:meta-llama/Llama-3.3-70B-Instruct|Llama 3.3 70B,hf:deepseek-ai/DeepSeek-V3.2|DeepSeek V3.2,hf:google/gemma-4-31B-it|Gemma 4 31B,hf:Qwen/Qwen3-235B-A22B-Instruct-2507|Qwen3 235B"

# HuggingFace API Key (For models with "hf:" prefix)
HF_API_KEY=hf_your-huggingface-key-here

# Image generation model
IMAGE_MODEL=google/gemini-2.5-flash-image

# Port for local server
PORT=3000
